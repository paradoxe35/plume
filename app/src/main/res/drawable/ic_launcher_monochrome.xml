<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+), where the launcher tints everything a single colour.

    The colour foreground cannot be reused here: its four overlapping paths flatten into one blob
    once they share a tint. This draws the vane as a single evenOdd path with the shaft punched out
    as a hole, so the quill keeps its shape when the detail can no longer come from colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vane outline, then the shaft as an inner contour that evenOdd renders as a gap. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M32,76 C32,54 44,36 74,28 C70,54 58,70 38,76 Z
                          M34.99,76.84 L73.99,30.84 L72.01,29.16 L33.01,75.16 Z" />

    <!-- The nib point, detached from the vane so it still reads at small sizes. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27.5,84.5 L34.5,76.2 L36.5,78.9 Z" />
</vector>
