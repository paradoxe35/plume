<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared with the keyboard extension: without these the keyboard starts with default
         settings and no API key, and there is no way for the user to tell why. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.me.pngwasi.plume</string>
    </array>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)me.pngwasi.plume.shared</string>
    </array>
</dict>
</plist>
